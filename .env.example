# Variables de entorno del servidor.
#
# Copiá este archivo a `.env.local` y completá los valores. `.env.local` está
# en `.gitignore`; este archivo de ejemplo sí se versiona.
#
# NUNCA pegues una URI real con contraseña en este archivo: queda en el
# historial de git para siempre.

# ---------------------------------------------------------------------------
# Azure DocumentDB for MongoDB vCore
# ---------------------------------------------------------------------------
# La URI sale de la vista "Connection string" del cluster en el portal.
#
# La cuenta es un cluster **vCore** (Free Tier): cluster MongoDB dedicado con
# 32 GB de almacenamiento, a costo cero, de por vida, uno por suscripción.
# Se pide al crear el cluster — después no se puede activar.
#
# Ojo con tres cosas del Free Tier:
#   - No hay Backup/Restore. La exportación a GeoJSON/Excel y el respaldo en
#     el blob storage son el plan de continuidad.
#   - No hay Diagnostic Logging, así que el consumo no se ve en el portal.
#   - El cluster se pausa a los 60 días de inactividad y el primer request
#     después paga lareanudación.
#
# `retrywrites=false` es obligatorio: Cosmos/DocumentDB no implementa los
# reintentos de escritura del driver de MongoDB.
#
# LA CONTRASEÑA VA CODIFICADA. La especificación de connection string de
# MongoDB exige percent-encoding de estos caracteres dentro de la contraseña:
#   :  @  /  ?  #  [  ]
# Sin codificar, cada uno rompe el parseo de una forma distinta y el error
# que devuelve el driver no dice nada sobre la causa real: un "#" abre un
# fragmento, un "@" confunde el host, una "?" corta la URI. El validador de
# `lib/server/env.ts` detecta esto y te dice qué codificar. Para generarlo:
#   node -e "console.log(encodeURIComponent('tu-clave-con-#-simbolos'))"
MONGODB_URI=mongodb+srv://<usuario>:<contraseña-codificada>@<cluster>.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000

# Nombre de la base de datos dentro del cluster.
MONGODB_DB=geopin

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Secreto de firma de sesión. Mínimo 32 caracteres.
# Generalo con: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Origen público de la aplicación, sin barra final.
# En desarrollo: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Administrador inicial
# ---------------------------------------------------------------------------
# El rol no se puede asignar en el registro, así que el primer administrador
# lo crea el seeder. Si estas dos variables no están, `pnpm seed` siembra solo
# los esquemas y avisa de cómo crear el admin.
#
# La contraseña va por entorno y no por argumentos de línea de comandos: los
# argumentos quedan en el historial del shell y en la lista de procesos.
#
# OJO: el parser de `.env` de Node corta el valor en el primer "#", así que
# un valor sin comillas con "#" llega truncado. Si tu contraseña lo tiene,
# entrecomillalo:  ADMIN_PASSWORD="Clave#2026"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
