# Variables de entorno del servidor.
#
# Copiá este archivo a `.env.local` y completá los valores. `.env.local` está
# en `.gitignore`; este archivo de ejemplo sí se versiona.

# ---------------------------------------------------------------------------
# Azure Cosmos DB for MongoDB
# ---------------------------------------------------------------------------
# La cuenta se crea desde el portal con "Apply Free Tier Discount = Apply":
# el free tier da 1000 RU/s y 25 GB de forma indefinida, pero hay que pedirlo
# al crear la cuenta — después no se puede activar.
#
# La URI sale de "Connection strings" en la sección "MongoDB" de la cuenta.
# `retrywrites=false` es obligatorio: Cosmos DB for MongoDB no implementa los
# reintentos de escritura del driver de MongoDB.
MONGODB_URI=mongodb+srv://<usuario>:<clave>@<cuenta>.mongodb.cosmos.azure.com/?ssl=true&retrywrites=false&maxIdleTimeMS=120000

# Nombre de la base de datos dentro de la cuenta.
MONGODB_DB=geopin

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Secreto de firma de sesión. Mínimo 32 caracteres.
# Generalo con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origen público de la aplicación, sin barra final.
# En desarrollo: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
